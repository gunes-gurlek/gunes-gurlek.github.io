<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Güneş Gürlek | Bilgisayar Mühendisi</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- Header / Navbar -->
    <header>
        <nav class="container">
            <a href="#" class="logo">&lt;GunesGurlek /&gt;</a>
            <ul class="nav-links">
                <li><a href="#about">Hakkımda</a></li>
                <li><a href="#projects">Projeler</a></li>
                <li><a href="#skills">Yetenekler</a></li>
                <li><a href="#contact">İletişim</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section (Resim + Özgeçmiş + CV İndir) -->
    <section id="about" class="hero container">
        <div class="hero-profile-img">
            <!-- Profil resminizi proje klasörüne "profile.jpg" olarak kaydedip buraya bağlayabilirsiniz -->
            <img src="profile.jpg" alt="Güneş Gürlek" onerror="this.src='https://via.placeholder.com/220?text=G%C3%BCne%C5%9F+G%C3%BCrlek'">
        </div>
        <div class="hero-content">
            <h1>Merhaba, Ben <span class="highlight">Güneş Gürlek</span> 👋</h1>
            <h2>Bilgisayar Mühendisi & Mobil Uygulama Geliştirici</h2>
            <p>Başkent Üniversitesi Bilgisayar Mühendisliği mezunuyum. Mobil uygulama geliştirme (Flutter), yapay zeka entegrasyonları, görüntü işleme ve gömülü sistemler üzerine yenilikçi çözümler üretiyorum.</p>
            <div class="hero-buttons">
                <!-- CV İndirme Butonu: CV dosyanızı proje klasörüne "Gunes_Gurlek_CV.pdf" adıyla ekleyin -->
                <a href="Gunes_Gurlek_CV.pdf" download class="btn btn-cv"><i class="fas fa-file-download"></i> CV'mi İndir</a>
                <a href="#projects" class="btn btn-primary">Projelerimi İncele</a>
                <a href="#contact" class="btn btn-secondary">İletişime Geç</a>
            </div>
        </div>
    </section>

    <!-- Projeler -->
    <section id="projects" class="container">
        <h2 class="section-title">Öne Çıkan Projeler</h2>
        <div class="projects-grid">
            
            <!-- SafeStep -->
            <div class="project-card">
                <div class="project-info">
                    <span class="badge">Donanım & AI Entegrasyonu</span>
                    <h3>SafeStep – Akıllı Gözlük Sistemi</h3>
                    <p>Görme engelli bireylerin günlük hayattaki engelleri ve tehlikeleri fark etmesini sağlayan, gerçek zamanlı nesne tespiti ve sesli geri bildirim sunan akıllı gözlük sistemi.</p>
                    <div class="tech-stack">
                        <span>Object Detection</span>
                        <span>Embedded Systems</span>
                        <span>Python</span>
                        <span>Audio Feedback</span>
                    </div>
                    <div class="project-links">
                        <a href="https://github.com" target="_blank" class="project-link"><i class="fab fa-github"></i> GitHub</a>
                    </div>
                </div>
            </div>

            <!-- SnapMap -->
            <div class="project-card">
                <div class="project-info">
                    <span class="badge">Mobil Uygulama</span>
                    <h3>SnapMap – Konum Bazlı Fotoğraf Paylaşımı</h3>
                    <p>Kullanıcıların harita üzerinde anlık konumlarına bağlı olarak fotoğraf paylaşmalarına ve çevrelerindeki anları keşfetmelerine olanak tanıyan gerçek zamanlı mobil uygulama.</p>
                    <div class="tech-stack">
                        <span>Flutter</span>
                        <span>Dart</span>
                        <span>Google Maps API</span>
                        <span>Firebase</span>
                    </div>
                    <div class="project-links">
                        <a href="https://github.com" target="_blank" class="project-link"><i class="fab fa-github"></i> GitHub</a>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Yetenekler -->
    <section id="skills" class="container">
        <h2 class="section-title">Teknik Yetenekler</h2>
        <div class="skills-grid">
            <div class="skill-category">
                <h3>Mobil & Yazılım</h3>
                <p>Flutter, Dart, Android Studio, REST API Entegrasyonları</p>
            </div>
            <div class="skill-category">
                <h3>Diller & Araçlar</h3>
                <p>Python, C++, C#, Git, GitHub, Firebase</p>
            </div>
        </div>
    </section>

    <!-- İletişim Formu ve Mail Yollama -->
    <section id="contact" class="container">
        <h2 class="section-title text-center">Bana Mesaj Gönderin</h2>
        <p class="text-center subtitle">Projelerim hakkında konuşmak veya iş birliği yapmak için doğrudan bana mail atabilirsiniz.</p>
        
        <div class="contact-wrapper">
            <!-- Formspree Entegrasyonu: action kısmına kendi formspree linkinizi veya mailto adresinizi ekleyebilirsiniz -->
            <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="contact-form">
                <div class="form-group">
                    <label for="name">Adınız Soyadınız</label>
                    <input type="text" id="name" name="name" placeholder="Örn: Ahmet Yılmaz" required>
                </div>
                <div class="form-group">
                    <label for="email">E-posta Adresiniz</label>
                    <input type="email" id="email" name="email" placeholder="ahmet@example.com" required>
                </div>
                <div class="form-group">
                    <label for="message">Mesajınız</label>
                    <textarea id="message" name="message" rows="5" placeholder="Mesajınızı buraya yazın..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-paper-plane"></i> Mesajı Gönder</button>
            </form>

            <div class="social-links-container text-center">
                <h3>Diğer Bağlantılar</h3>
                <div class="social-links">
                    <a href="https://linkedin.com/in/kullaniciadi" target="_blank"><i class="fab fa-linkedin"></i> LinkedIn</a>
                    <a href="https://github.com/kullaniciadi" target="_blank"><i class="fab fa-github"></i> GitHub</a>
                    <a href="mailto:epostaniz@gmail.com"><i class="fas fa-envelope"></i> Doğrudan E-posta</a>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <p>© 2026 Güneş Gürlek. Tüm hakları saklıdır.</p>
    </footer>

</body>
</html>
