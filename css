* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #0f172a;
    color: #f8fafc;
    line-height: 1.6;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
}

header {
    background-color: #1e293b;
    position: sticky;
    top: 0;
    z-index: 100;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.5rem;
    font-weight: bold;
    color: #38bdf8;
    text-decoration: none;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 1.5rem;
}

.nav-links a {
    color: #94a3b8;
    text-decoration: none;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #38bdf8;
}

/* Hero & Profil Resmi Alanı */
.hero {
    min-height: 70vh;
    display: flex;
    align-items: center;
    gap: 3rem;
    flex-wrap: wrap;
}

.hero-profile-img img {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #38bdf8;
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
}

.hero-content {
    flex: 1;
    min-width: 300px;
}

.hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

.highlight {
    color: #38bdf8;
}

.hero h2 {
    color: #94a3b8;
    font-size: 1.3rem;
    margin-bottom: 1rem;
}

.hero-buttons {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}

.btn {
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: none;
    cursor: pointer;
}

.btn-cv {
    background-color: #10b981;
    color: white;
}

.btn-cv:hover {
    background-color: #059669;
}

.btn-primary {
    background-color: #0284c7;
    color: white;
}

.btn-primary:hover {
    background-color: #0369a1;
}

.btn-secondary {
    border: 1px solid #334155;
    color: #f8fafc;
}

.btn-secondary:hover {
    background-color: #1e293b;
}

.section-title {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #334155;
    padding-bottom: 0.5rem;
}

.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
}

.project-card {
    background-color: #1e293b;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid #334155;
    transition: transform 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);
}

.badge {
    background-color: #0369a1;
    color: #e0f2fe;
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
}

.project-card h3 {
    margin: 0.8rem 0;
}

.tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
}

.tech-stack span {
    background-color: #334155;
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
}

.project-links a {
    color: #38bdf8;
    text-decoration: none;
    font-weight: bold;
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
}

.skill-category {
    background-color: #1e293b;
    padding: 1.5rem;
    border-radius: 8px;
}

.text-center {
    text-align: center;
}

.subtitle {
    color: #94a3b8;
    margin-bottom: 2rem;
}

/* İletişim Formu Stilleri */
.contact-wrapper {
    max-width: 600px;
    margin: 0 auto;
    background-color: #1e293b;
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid #334155;
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: left;
}

.form-group label {
    font-weight: 600;
    color: #cbd5e1;
}

.form-group input, .form-group textarea {
    padding: 0.8rem;
    border-radius: 6px;
    border: 1px solid #334155;
    background-color: #0f172a;
    color: #fff;
    font-size: 1rem;
}

.form-group input:focus, .form-group textarea:focus {
    outline: none;
    border-color: #38bdf8;
}

.btn-block {
    width: 100%;
    justify-content: center;
}

.social-links-container {
    margin-top: 2rem;
    border-top: 1px solid #334155;
    padding-top: 1.5rem;
}

.social-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1rem;
}

.social-links a {
    color: #38bdf8;
    text-decoration: none;
    font-size: 1.1rem;
}

footer {
    text-align: center;
    padding: 2rem;
    background-color: #020617;
    color: #64748b;
    margin-top: 3rem;
}
